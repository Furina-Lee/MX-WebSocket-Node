{
  "log_level": "info",
  "panel": {
    "api_host": "https://panel.example.com",
    "api_key": "REPLACE_WITH_PANEL_SERVER_TOKEN",
    "node_id": 105,
    "node_type": "mx",
    "pull_interval": 10,
    "push_interval": 15,
    "node_config_defaults_path": "/opt/mx-websocket-node/node_config.defaults.json"
  },
  "panels": [],
  "mundoproxy": {
    "asset_path": "/var/lib/mx-websocket-node",
    "log_level": "warning",
    "listen_ip": "0.0.0.0",
    "brutalMbps": -1,
    "report_min_traffic_kb": 10
  },
  "cert": {
    "mode": "self",
    "cert_file": "/var/lib/mx-websocket-node/cert.pem",
    "key_file": "/var/lib/mx-websocket-node/key.pem"
  },
  "bridge": {
    "binary": "/opt/mx-websocket-node/proxy-node",
    "state_dir": "/var/lib/mx-websocket-node"
  }
}
